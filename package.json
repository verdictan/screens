{
  "name": "@verdictan/screens",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local screen registry and visual review workspace for people and AI agents",
  "engines": {
    "node": ">=22.22.2"
  },
  "bin": {
    "screens": "src/cli.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node src/cli.mjs serve",
    "test": "node --experimental-vm-modules --test test/*.test.mjs",
    "test:integration": "node --test test/network.integration.mjs",
    "check": "node scripts/check.mjs",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:package": "node scripts/package-skills.mjs",
    "skills:validate": "node scripts/validate-skills.mjs",
    "build": "vite build",
    "prestart": "npm run build",
    "test:e2e": "playwright test",
    "test:all": "npm run check && npm run test:coverage",
    "pretest": "npm run build",
    "setup": "node scripts/setup.mjs",
    "test:coverage": "vite build --mode coverage && c8 node --experimental-vm-modules --test test/*.test.mjs test/network.integration.mjs && playwright test test/e2e/workflow.spec.mjs test/e2e/theme.spec.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.59.0",
    "playwright": "1.64.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "thumbhash": "0.1.1",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "c8": "12.0.0",
    "jsdom": "30.1.3",
    "postcss": "8.5.30",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "c8": {
      "test-exclude": {
        "glob": "14.0.4",
        "minimatch": "11.0.5"
      }
    }
  }
}
