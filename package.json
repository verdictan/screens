{
  "name": "@verdictan/screens",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local screen registry and visual review workspace for people and AI agents",
  "engines": {
    "node": ">=22.22.2"
  },
  "bin": {
    "screens": "src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs serve",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/network.integration.mjs",
    "check": "node scripts/check.mjs",
    "skills:install": "node scripts/install-skills.mjs",
    "skills:package": "node scripts/package-skills.mjs",
    "skills:validate": "node scripts/validate-skills.mjs",
    "build": "vite build",
    "prestart": "npm run build",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm run check && npm test && npm run test:integration && npm run test:e2e",
    "pretest": "npm run build",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.59.0",
    "playwright": "1.64.1"
  },
  "devDependencies": {
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.30",
    "@playwright/test": "1.64.1"
  }
}
