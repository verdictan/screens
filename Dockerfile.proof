FROM node:22.23.4-bookworm-slim
WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=0 XDG_CACHE_HOME=/tmp/screens-cache XDG_CONFIG_HOME=/tmp/screens-config
COPY package.json package-lock.json ./
COPY scripts/bundle-runtime.mjs ./scripts/
RUN npm ci
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && chmod -R a+rX node_modules/playwright-core/.local-browsers && rm -rf /var/lib/apt/lists/*
COPY . .
RUN npm run build && mkdir -p test-results && chown -R node:node /app
USER node
CMD ["sleep", "infinity"]
